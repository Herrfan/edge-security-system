# ================================================
# Edge Security System — Example Environment File
# Copy to .env and fill in real values as needed.
# ================================================

# --- Application ---
APP_NAME=edge-security-system
APP_VERSION=0.1.0
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO

# --- Database ---
# SQLite path (relative to repo root or absolute)
DATABASE_URL=sqlite:///./data/app.db

# --- LLM Provider (Ollama) ---
# Ollama default is 127.0.0.1:11434 — keep bound to localhost only
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b
LLM_TIMEOUT_SECONDS=60
# Set to mock to skip real LLM calls (degraded mode)
LLM_PROVIDER=ollama

# --- Embedding Provider ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# --- Security Boundary ---
# Comma-separated authorized IP ranges (CIDR) for simulation / dry-run only
AUTHORIZED_ASSETS=127.0.0.0/8
# Whether to allow REAL execution (NEVER set to true in dev / prod without explicit approval)
ALLOW_REAL_EXECUTION=false
# Default action execution mode
DEFAULT_EXECUTION_MODE=DRY_RUN

# --- Knowledge ---
KNOWLEDGE_INDEX_DIR=./data/knowledge_index

# --- Retrieval ---
# keyword | vector | hybrid
RETRIEVAL_MODE=hybrid
VECTOR_BACKEND=sqlite_vec
# Set to mock when vector backend unavailable
VECTOR_PROVIDER=ollama

# --- Paths ---
DATA_DIR=./data
MODELS_DIR=./models
LOG_DIR=./logs
