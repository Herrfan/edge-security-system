# ============================================================
# edge-security-system — production .env template
#
# Copy this file to /opt/edge-security-system/.env and edit it.
# All settings MUST stay within the values this repo ships — do NOT
# introduce env vars we don't consume. Unknown keys are ignored.
# ============================================================

# ---- identity ----
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=WARNING

# ============================================================
# SAFETY BOUNDARY (DO NOT CHANGE unless you fully understand nftables
# implications — allow_real_execution=true WILL make Phase 11/12
# backends touch the host firewall. On a real edge device that means
# iptables/nft runs as root. There is NO "undo" at the product layer;
# only the backend rollback (run_atomic) protects you from half-applies.
# ============================================================
ALLOW_REAL_EXECUTION=false

# ---- Ollama ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
LLM_PROVIDER=ollama
VECTOR_BACKEND=sqlite_vec
RETRIEVAL_MODE=hybrid

# ---- auth ----
# PRODUCTION MUST set AUTH_JWT_SECRET to a long random string (>= 32 bytes).
# Leave it empty here if you plan to inject it via your secrets manager.
AUTH_ENABLED=false
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL_MINUTES=60

# ---- observability ----
METRICS_PERSIST_ENABLED=true
METRICS_SNAPSHOT_INTERVAL_MINUTES=15
# VM_REMOTE_WRITE_URL=https://vm.example.com/api/v1/push   # uncomment if VM present

# ---- mTLS ----
MTLS_ENABLED=false
MTLS_KEYFILE=
MTLS_CERTFILE=
MTLS_CA_FILE=

# ---- rate-limit (per-role rps) ----
RATE_LIMIT_ADMIN_RPS=100
RATE_LIMIT_OPERATOR_RPS=50
RATE_LIMIT_VIEWER_RPS=20
RATE_LIMIT_ANONYMOUS_RPS=30
